rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // دالة للتحقق من المشرف
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ===== المستخدمون =====
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role','accountStatus','subscription']);
      allow delete: if isAdmin();
      allow read, write: if isAdmin();
    }

    // ===== المباريات (قراءة عامة، كتابة للمشرف) =====
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== الدوريات =====
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== الفرق =====
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== الأخبار =====
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== الترتيب =====
    match /standings/{standingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== الإحصائيات =====
    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== المفضلة =====
    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== الاشتراكات (لا يمكن للمستخدم الكتابة) =====
    match /subscriptions/{subId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ===== مصادر البث (خاصة) =====
    match /streamSources/{sourceId} {
      allow read: if request.auth != null;  // تحقق من الترخيص من Cloud Function
      allow write: if isAdmin();
    }

    // ===== الإعلانات =====
    match /advertisements/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== المشرفون =====
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // فقط يدويًا من Console
    }

    // ===== إعدادات عامة =====
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // رفض أي شيء آخر
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
